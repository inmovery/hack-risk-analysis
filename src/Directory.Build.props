<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Authors>Aeza Risk</Authors>
        <Company>Aeza Risk</Company>
        <!-- Версия шаблона сервиса (выводится в OpenAPI) -->
        <TemplateVersion>7.5.1</TemplateVersion>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Образ выполнения chiseled (без ICU): форматирование денег и дат — инвариантное -->
        <InvariantGlobalization>true</InvariantGlobalization>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="TemplateVersion" Value="$(TemplateVersion)"/>
    </ItemGroup>
</Project>
