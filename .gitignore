# В репозитории — код, документация, сборка и деплой; всё остальное остаётся локально
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.dockerignore
!/.env.example
!/README.md
!/Aeza.Risk.slnx
!/global.json
!/nuget.config
!/dotnet-tools.json
!/Dockerfile
!/docker-compose.yml
!/docker-compose.local.yaml
!/.gitlab-ci.yml
!/.gitlab/
!/Кейс_Aeza_Анализ_рисков_оттоков.pdf
!/src/
!/test/
!/web/
!/deploy/
!/tools/
!/contracts/
!/docs/
!/test_data_yandex/

/docs/*
!/docs/scoring.md
!/docs/architecture.md
!/docs/ml-design.md
!/docs/ui-design.md
/contracts/*
!/contracts/openapi.json
/test_data_yandex/*
!/test_data_yandex/data.json

# Локальные файлы развёртывания, не нужные пайплайну и Compose
/deploy/front/
/deploy/public/
/deploy/postgres/
/deploy/gitlab/
/deploy/k8s/cluster/
/deploy/k8s/values/local/
/deploy/k8s/*.sh
/deploy/README.md
/deploy/k8s/README.md

# Секреты
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
/deploy/nginx/htpasswd
/web/e2e/.auth/

# Сборка, зависимости, результаты тестов
bin/
obj/
node_modules/
dist/
TestResults/
/web/test-results/
/web/playwright-report/
/web/tsconfig.tsbuildinfo
*.user
.vs/
.idea/
