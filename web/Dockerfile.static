# Панель для Kubernetes: статика на непривилегированном nginx.
# docker build -f web/Dockerfile.static [--build-arg VITE_API_BASE=https://api.example.com] -t aeza-risk-front web
FROM node:24.22.1-alpine AS build
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html tsconfig.json vite.config.ts ./
COPY public ./public
COPY src ./src
ARG VITE_API_BASE=""
ENV VITE_API_BASE=${VITE_API_BASE}
# Если адрес API задан, он обязан попасть в сборку (иначе панель молча пойдёт в свой origin)
RUN npm run build && { [ -z "$VITE_API_BASE" ] || grep -rqF "$VITE_API_BASE" dist/assets; }

FROM nginxinc/nginx-unprivileged:1.31.7-alpine
# Шаблон обрабатывается envsubst при старте (/etc/nginx/templates → /etc/nginx/conf.d)
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /web/dist /usr/share/nginx/html
ENV API_CONNECT_SRC=""
EXPOSE 8080
