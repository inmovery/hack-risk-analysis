# Скопируйте в .env и заполните пустые значения (например, openssl rand -base64 24)
POSTGRES_PASSWORD=
# Роль приложения aeza_app в БД (только DML, создаёт Migrator)
APP_DB_PASSWORD=
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
# Необязательный пользователь только для чтения (роль analyst)
BOOTSTRAP_ANALYST_LOGIN=
BOOTSTRAP_ANALYST_PASSWORD=
# Bearer-токен системы-источника: POST /api/v1/source/events и PUT /api/v1/source/snapshot; им работает симулятор (обязателен)
INGEST_TOKEN=
# true — данные только событиями симулятора (страница «Симуляция»); false — тестовые данные снимком в пустую БД
EVENTS_ONLY=true
# Порт сервиса на хосте; APP_BIND=0.0.0.0 — открыть в сеть
APP_PORT=8080
APP_BIND=127.0.0.1
# Профиль tls (nginx)
DOMAIN=localhost
SECURE_COOKIES=false
BEHIND_PROXY=false
# Панель на отдельном домене: CORS_ORIGIN=https://app.example.com, SPA_ENABLED=false
CORS_ORIGIN=
SPA_ENABLED=true
# true — Swagger UI и спецификация только после входа
DOCS_REQUIRE_AUTH=false
# Профиль observability
GRAFANA_ADMIN_PASSWORD=
# Домен мониторинга (Grafana за nginx)
MONITORING_DOMAIN=
