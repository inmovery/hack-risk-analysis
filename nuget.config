<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Репозиторий собирается только из публичного nuget.org: воспроизводимо локально, в Docker и CI. -->
  <packageSources>
    <clear />
    <add key="nuget-public" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="nuget-public">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
